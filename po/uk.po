#: src/cli/main.cpp
msgid "yes"
msgstr "так"

#: src/cli/main.cpp
msgid "no"
msgstr "ні"

#: src/cli/main.cpp
msgid "Show this help message."
msgstr "Показати цю довідку."

#: src/cli/main.cpp
msgid "Print the tether version."
msgstr "Показати версію tether."

#: src/cli/main.cpp
msgid "Retrieve the current Wayland clipboard text."
msgstr "Отримати поточний текст із буфера обміну Wayland."

#: src/cli/main.cpp
msgid "Take string input and copy it to the local Wayland clipboard."
msgstr ""
"Прочитати текст із входу та скопіювати його до локального буфера обміну "
"Wayland."

#: src/cli/main.cpp
msgid "Send a file through tether."
msgstr "Надіслати файл через tether."

#: src/cli/main.cpp
msgid "Start the browser Native Messaging Host proxy loop."
msgstr "Запустити проксі-цикл Native Messaging Host браузера."

#: src/cli/main.cpp
msgid "Scan the local network for tetherd instances via mDNS."
msgstr "Знайти екземпляри tetherd у локальній мережі через mDNS."

#: src/cli/main.cpp
msgid "Connect over TCP to daemon ip instead of UNIX Socket."
msgstr "Під'єднатися через TCP до ip демона замість сокета UNIX."

#: src/cli/main.cpp
msgid "Connect over TCP port (default 5134)."
msgstr "Порт TCP для з'єднання (типово 5134)."

#: src/cli/main.cpp
msgid "Discovery scan duration in milliseconds (default 3000)."
msgstr "Тривалість пошуку в мілісекундах (типово 3000)."

#: src/cli/main.cpp
msgid "List all paired connection devices."
msgstr "Показати всі спарені пристрої."

#: src/cli/main.cpp
msgid "Show the one-time system setup Bluetooth still needs."
msgstr "Показати одноразове налаштування системи, якого ще потребує Bluetooth."

#: src/cli/main.cpp
msgid "Show Bluetooth adapter capability and delivery mode."
msgstr "Показати можливості адаптера Bluetooth і режим доставки."

#: src/cli/main.cpp
msgid "List Bluetooth devices known to BlueZ."
msgstr "Показати пристрої Bluetooth, відомі BlueZ."

#: src/cli/main.cpp
msgid "Show Bluetooth link and profile connection state."
msgstr "Показати стан з'єднання Bluetooth і профілів."

#: src/cli/main.cpp
msgid "List iPhone message conversations."
msgstr "Показати розмови з повідомленнями на iPhone."

#: src/cli/main.cpp
msgid "Show messages in one conversation."
msgstr "Показати повідомлення однієї розмови."

#: src/cli/main.cpp
msgid "Reply in one conversation."
msgstr "Відповісти в одній розмові."

#: src/cli/main.cpp
msgid "List iPhone contacts, or search them by name or number."
msgstr "Показати контакти iPhone або знайти їх за іменем чи номером."

#: src/cli/main.cpp
msgid "Pair with an iPhone over Bluetooth."
msgstr "Створити пару з iPhone через Bluetooth."

#: src/cli/main.cpp
msgid ""
"Ask the iPhone to authenticate directly instead of connecting first. Tether "
"falls back to this on its own; use it to skip straight there."
msgstr ""
"Запитати в iPhone пряму автентифікацію замість спершу під'єднання. Tether "
"сам переходить до цього; використовуйте, щоб перейти одразу."

#: src/cli/main.cpp
msgid "Remove a Bluetooth bond."
msgstr "Вилучити зв'язок Bluetooth."

#: src/cli/main.cpp
msgid ""
"Re-advertise for ANCS so the iPhone shows its permission toggles again, "
"without removing the bond."
msgstr ""
"Знову оголосити про себе для ANCS, щоб iPhone знову показав свої дозволи, не "
"вилучаючи зв'язок."

#: src/cli/main.cpp
msgid "Connect to the iPhone over Bluetooth, or stop."
msgstr "Під'єднатися до iPhone через Bluetooth або припинити."

#: src/cli/main.cpp
msgid "Turn notification mirroring on or off."
msgstr "Увімкнути або вимкнути дублювання сповіщень."

#: src/cli/main.cpp
msgid "Mirror notification titles and bodies, not just the app."
msgstr "Дублювати заголовки та текст сповіщень, а не лише програму."

#: src/cli/main.cpp
msgid ""
"How message history and contacts are kept on disk. Encrypted uses a key from "
"the desktop keyring; none deletes what is stored and keeps nothing further."
msgstr ""
"Як історія повідомлень і контакти зберігаються на диску. encrypted "
"використовує ключ зі сховища ключів стільниці; none вилучає збережене й "
"більше нічого не зберігає."

#: src/cli/main.cpp
msgid "Choose which Bluetooth controller to use."
msgstr "Вибирає, який адаптер Bluetooth використовувати."

#: src/cli/main.cpp
msgid "List mirrored iPhone notifications."
msgstr "Показати продубльовані сповіщення з iPhone."

#: src/cli/main.cpp
msgid "List calls on the iPhone."
msgstr "Показати виклики на iPhone."

#: src/cli/main.cpp
msgid "Place a call from the iPhone."
msgstr "Здійснити виклик з iPhone."

#: src/cli/main.cpp
msgid "Answer the ringing call."
msgstr "Відповісти на вхідний виклик."

#: src/cli/main.cpp
msgid "Hang up every call."
msgstr "Завершити всі виклики."

#: src/cli/main.cpp
msgid ""
"Turn call control on or off. Calls run over Bluetooth Hands-Free; the audio "
"stays on the iPhone."
msgstr ""
"Увімкнути або вимкнути керування викликами. Виклики йдуть через Bluetooth "
"Hands-Free; звук залишається на iPhone."

#: src/cli/main.cpp
msgid "Print a redacted Bluetooth report for a bug report."
msgstr "Вивести очищений звіт Bluetooth для повідомлення про помилку."

#: src/cli/main.cpp
msgid ""
"Install the browser and mail extension's native messaging manifests for this "
"user. Needed only for portable builds; the distro packages install them "
"system-wide."
msgstr ""
"Встановлює маніфести нативного обміну повідомленнями для розширення браузера "
"та пошти для цього користувача. Потрібно лише для переносних збірок; пакунки "
"дистрибутивів встановлюють їх для всієї системи."

#: src/cli/main.cpp
msgid ""
"Write the tether-btclass@.service unit, which sets the Bluetooth adapter "
"class iOS requires. Needs root, and never enables it. Needed only for "
"portable builds; the distro packages install it."
msgstr ""
"Записує юніт tether-btclass@.service, який задає клас адаптера Bluetooth, "
"потрібний iOS. Потребує root і ніколи його не вмикає. Потрібно лише для "
"переносних збірок; пакунки дистрибутива встановлюють його самі."

#: src/cli/main.cpp
msgid "Accept a pending pairing request locally."
msgstr "Прийняти локально запит на створення пари, що очікує."

#: src/cli/main.cpp
msgid "Remove a Wi-Fi pairing and drop its session."
msgstr "Вилучити пару Wi-Fi та закрити її сеанс."

#: src/cli/main.cpp
msgid "Send a pair_request over TCP to the daemon."
msgstr "Надіслати pair_request демону через TCP."

#: src/cli/main.cpp
msgid "tether - Wayland companion CLI"
msgstr "tether — допоміжна утиліта командного рядка для Wayland"

#: src/cli/main.cpp
msgid "Options:"
msgstr "Параметри:"

#: src/cli/main.cpp
msgid "Examples:"
msgstr "Приклади:"

#: src/cli/main.cpp
#, c-format
msgid "Installed %s\n"
msgstr "Встановлено: %s\n"

#: src/cli/main.cpp
#, c-format
msgid ""
"No browser or mail client profile was found for this user, so nothing was "
"installed. Start Firefox, Thunderbird, or Chromium once and run this again.\n"
msgstr ""
"Профіль браузера або поштового клієнта для цього користувача не знайдено, "
"тож нічого не встановлено. Запустіть один раз Firefox, Thunderbird або "
"Chromium і повторіть команду.\n"

#: src/cli/main.cpp
#, c-format
msgid ""
"\n"
"Restart the browser or mail client to pick this up.\n"
msgstr ""
"\n"
"Перезапустіть браузер або поштовий клієнт, щоб зміни набули чинності.\n"

#: src/cli/main.cpp
#, c++-format
msgid "Writing {} needs root. Run this with sudo.\n"
msgstr "Для запису {} потрібен root. Запустіть це через sudo.\n"

#: src/cli/main.cpp
#, c++-format
msgid "Could not write {}.\n"
msgstr "Не вдалося записати {}.\n"

#: src/cli/main.cpp
#, c-format
msgid ""
"\n"
"It is not enabled. Run 'systemctl daemon-reload', then 'systemctl enable --"
"now tether-btclass@hci0' to apply it.\n"
msgstr ""
"\n"
"Він не увімкнений. Виконайте 'systemctl daemon-reload', потім 'systemctl "
"enable --now tether-btclass@hci0', щоб застосувати його.\n"

#: src/cli/main.cpp
msgid "Could not read Bluetooth status from the daemon.\n"
msgstr "Не вдалося прочитати стан Bluetooth у демона.\n"

#: src/cli/main.cpp
#, c-format
msgid "Bluetooth: unavailable (is bluetoothd running?)\n"
msgstr "Bluetooth: недоступний (чи запущено bluetoothd?)\n"

#: src/cli/main.cpp
#, c-format
msgid "Bluetooth setup is complete. Nothing to do.\n"
msgstr "Налаштування Bluetooth завершено. Немає що робити.\n"

#: src/cli/main.cpp
#, c-format
msgid ""
"\n"
"%zu step left before the iPhone Bluetooth features work:\n"
msgid_plural ""
"\n"
"%zu steps left before the iPhone Bluetooth features work:\n"
msgstr[0] ""
"\n"
"Залишився %zu крок, доки функції Bluetooth iPhone запрацюють:\n"
msgstr[1] ""
"\n"
"Залишилося %zu кроки, доки функції Bluetooth iPhone запрацюють:\n"
msgstr[2] ""
"\n"
"Залишилося %zu кроків, доки функції Bluetooth iPhone запрацюють:\n"

#: src/cli/main.cpp
#, c-format
msgid ""
"\n"
"Re-run 'tether --bt-setup' afterwards to confirm.\n"
msgstr ""
"\n"
"Потім запустіть 'tether --bt-setup' ще раз для підтвердження.\n"

