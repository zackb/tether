#: src/cli/main.cpp
msgid "yes"
msgstr "oui"

#: src/cli/main.cpp
msgid "no"
msgstr "non"

#: src/cli/main.cpp
msgid "Show this help message."
msgstr "Afficher cette aide."

#: src/cli/main.cpp
msgid "Print the tether version."
msgstr "Afficher la version de tether."

#: src/cli/main.cpp
msgid "Retrieve the current Wayland clipboard text."
msgstr "Récupérer le texte actuel du presse-papiers Wayland."

#: src/cli/main.cpp
msgid "Take string input and copy it to the local Wayland clipboard."
msgstr ""
"Lire du texte sur l'entrée et le copier dans le presse-papiers Wayland local."

#: src/cli/main.cpp
msgid "Send a file through tether."
msgstr "Envoyer un fichier via tether."

#: src/cli/main.cpp
msgid "Start the browser Native Messaging Host proxy loop."
msgstr "Démarrer la boucle proxy Native Messaging Host du navigateur."

#: src/cli/main.cpp
msgid "Scan the local network for tetherd instances via mDNS."
msgstr "Rechercher des instances de tetherd sur le réseau local via mDNS."

#: src/cli/main.cpp
msgid "Connect over TCP to daemon ip instead of UNIX Socket."
msgstr "Se connecter en TCP à l'ip du démon au lieu de la socket UNIX."

#: src/cli/main.cpp
msgid "Connect over TCP port (default 5134)."
msgstr "Port TCP de connexion (5134 par défaut)."

#: src/cli/main.cpp
msgid "Discovery scan duration in milliseconds (default 3000)."
msgstr "Durée de la recherche en millisecondes (3000 par défaut)."

#: src/cli/main.cpp
msgid "List all paired connection devices."
msgstr "Lister tous les appareils appairés."

#: src/cli/main.cpp
msgid "Show the one-time system setup Bluetooth still needs."
msgstr ""
"Afficher la configuration système ponctuelle encore requise par Bluetooth."

#: src/cli/main.cpp
msgid "Show Bluetooth adapter capability and delivery mode."
msgstr ""
"Afficher les capacités de l'adaptateur Bluetooth et le mode de livraison."

#: src/cli/main.cpp
msgid "List Bluetooth devices known to BlueZ."
msgstr "Lister les appareils Bluetooth connus de BlueZ."

#: src/cli/main.cpp
msgid "Show Bluetooth link and profile connection state."
msgstr "Afficher l'état du lien et des profils Bluetooth."

#: src/cli/main.cpp
msgid "List iPhone message conversations."
msgstr "Lister les conversations de l'iPhone."

#: src/cli/main.cpp
msgid "Show messages in one conversation."
msgstr "Afficher les messages d'une conversation."

#: src/cli/main.cpp
msgid "Reply in one conversation."
msgstr "Répondre dans une conversation."

#: src/cli/main.cpp
msgid "List iPhone contacts, or search them by name or number."
msgstr "Lister les contacts de l'iPhone, ou les rechercher par nom ou numéro."

#: src/cli/main.cpp
msgid "Pair with an iPhone over Bluetooth."
msgstr "Appairer un iPhone en Bluetooth."

#: src/cli/main.cpp
msgid ""
"Ask the iPhone to authenticate directly instead of connecting first. Tether "
"falls back to this on its own; use it to skip straight there."
msgstr ""
"Demander à l'iPhone de s'authentifier directement au lieu de se connecter "
"d'abord. Tether y recourt de lui-même ; utilisez cette option pour y aller "
"directement."

#: src/cli/main.cpp
msgid "Remove a Bluetooth bond."
msgstr "Supprimer un lien Bluetooth."

#: src/cli/main.cpp
msgid ""
"Re-advertise for ANCS so the iPhone shows its permission toggles again, "
"without removing the bond."
msgstr ""
"Se réannoncer pour ANCS afin que l'iPhone affiche de nouveau ses "
"autorisations, sans supprimer le lien."

#: src/cli/main.cpp
msgid "Connect to the iPhone over Bluetooth, or stop."
msgstr "Se connecter à l'iPhone en Bluetooth, ou arrêter."

#: src/cli/main.cpp
msgid "Turn notification mirroring on or off."
msgstr "Activer ou désactiver la duplication des notifications."

#: src/cli/main.cpp
msgid "Mirror notification titles and bodies, not just the app."
msgstr ""
"Dupliquer les titres et le contenu des notifications, pas seulement l'app."

#: src/cli/main.cpp
msgid ""
"How message history and contacts are kept on disk. Encrypted uses a key from "
"the desktop keyring; none deletes what is stored and keeps nothing further."
msgstr ""
"Comment l'historique des messages et les contacts sont conservés sur le "
"disque. encrypted utilise une clé du trousseau du bureau ; none supprime ce "
"qui est stocké et ne conserve plus rien."

#: src/cli/main.cpp
msgid "Choose which Bluetooth controller to use."
msgstr "Choisit l'adaptateur Bluetooth à utiliser."

#: src/cli/main.cpp
msgid "List mirrored iPhone notifications."
msgstr "Lister les notifications dupliquées de l'iPhone."

#: src/cli/main.cpp
msgid "List calls on the iPhone."
msgstr "Lister les appels sur l'iPhone."

#: src/cli/main.cpp
msgid "Place a call from the iPhone."
msgstr "Passer un appel depuis l'iPhone."

#: src/cli/main.cpp
msgid "Answer the ringing call."
msgstr "Répondre à l'appel entrant."

#: src/cli/main.cpp
msgid "Hang up every call."
msgstr "Raccrocher tous les appels."

#: src/cli/main.cpp
msgid ""
"Turn call control on or off. Calls run over Bluetooth Hands-Free; the audio "
"stays on the iPhone."
msgstr ""
"Activer ou désactiver la gestion des appels. Les appels passent par le mode "
"mains libres Bluetooth ; l'audio reste sur l'iPhone."

#: src/cli/main.cpp
msgid "Print a redacted Bluetooth report for a bug report."
msgstr "Afficher un rapport Bluetooth expurgé pour un rapport de bogue."

#: src/cli/main.cpp
msgid ""
"Install the browser and mail extension's native messaging manifests for this "
"user. Needed only for portable builds; the distro packages install them "
"system-wide."
msgstr ""
"Installe les manifestes de messagerie native de l'extension navigateur et "
"courrier pour cet utilisateur. Nécessaire uniquement pour les versions "
"portables ; les paquets de la distribution les installent pour tout le "
"système."

#: src/cli/main.cpp
msgid ""
"Write the tether-btclass@.service unit, which sets the Bluetooth adapter "
"class iOS requires. Needs root, and never enables it. Needed only for "
"portable builds; the distro packages install it."
msgstr ""
"Écrit l'unité tether-btclass@.service, qui définit la classe d'adaptateur "
"Bluetooth exigée par iOS. Nécessite root et ne l'active jamais. Utile "
"uniquement pour les builds portables ; les paquets de la distribution "
"l'installent."

#: src/cli/main.cpp
msgid "Accept a pending pairing request locally."
msgstr "Accepter localement une demande d'appairage en attente."

#: src/cli/main.cpp
msgid "Remove a Wi-Fi pairing and drop its session."
msgstr "Supprimer un appairage Wi-Fi et fermer sa session."

#: src/cli/main.cpp
msgid "Send a pair_request over TCP to the daemon."
msgstr "Envoyer un pair_request au démon en TCP."

#: src/cli/main.cpp
msgid "tether - Wayland companion CLI"
msgstr "tether - utilitaire compagnon pour Wayland"

