#: src/cli/main.cpp
msgid "yes"
msgstr "sim"

#: src/cli/main.cpp
msgid "no"
msgstr "não"

#: src/cli/main.cpp
msgid "Show this help message."
msgstr "Mostrar esta mensagem de ajuda."

#: src/cli/main.cpp
msgid "Print the tether version."
msgstr "Mostrar a versão do tether."

#: src/cli/main.cpp
msgid "Retrieve the current Wayland clipboard text."
msgstr "Obter o texto atual da área de transferência do Wayland."

#: src/cli/main.cpp
msgid "Take string input and copy it to the local Wayland clipboard."
msgstr ""
"Ler texto da entrada e copiá-lo para a área de transferência local do "
"Wayland."

#: src/cli/main.cpp
msgid "Send a file through tether."
msgstr "Enviar um arquivo pelo tether."

#: src/cli/main.cpp
msgid "Start the browser Native Messaging Host proxy loop."
msgstr "Iniciar o laço de proxy do Native Messaging Host do navegador."

#: src/cli/main.cpp
msgid "Scan the local network for tetherd instances via mDNS."
msgstr "Procurar instâncias do tetherd na rede local via mDNS."

#: src/cli/main.cpp
msgid "Connect over TCP to daemon ip instead of UNIX Socket."
msgstr "Conectar por TCP ao ip do daemon em vez do socket UNIX."

#: src/cli/main.cpp
msgid "Connect over TCP port (default 5134)."
msgstr "Porta TCP de conexão (padrão 5134)."

#: src/cli/main.cpp
msgid "Discovery scan duration in milliseconds (default 3000)."
msgstr "Duração da busca em milissegundos (padrão 3000)."

#: src/cli/main.cpp
msgid "List all paired connection devices."
msgstr "Listar todos os dispositivos pareados."

#: src/cli/main.cpp
msgid "Show the one-time system setup Bluetooth still needs."
msgstr "Mostrar a configuração única do sistema que o Bluetooth ainda precisa."

#: src/cli/main.cpp
msgid "Show Bluetooth adapter capability and delivery mode."
msgstr "Mostrar a capacidade do adaptador Bluetooth e o modo de entrega."

#: src/cli/main.cpp
msgid "List Bluetooth devices known to BlueZ."
msgstr "Listar os dispositivos Bluetooth conhecidos pelo BlueZ."

#: src/cli/main.cpp
msgid "Show Bluetooth link and profile connection state."
msgstr "Mostrar o estado do enlace Bluetooth e dos perfis."

#: src/cli/main.cpp
msgid "List iPhone message conversations."
msgstr "Listar as conversas de mensagens do iPhone."

#: src/cli/main.cpp
msgid "Show messages in one conversation."
msgstr "Mostrar as mensagens de uma conversa."

#: src/cli/main.cpp
msgid "Reply in one conversation."
msgstr "Responder em uma conversa."

#: src/cli/main.cpp
msgid "List iPhone contacts, or search them by name or number."
msgstr "Listar os contatos do iPhone, ou procurá-los por nome ou número."

#: src/cli/main.cpp
msgid "Pair with an iPhone over Bluetooth."
msgstr "Parear com um iPhone por Bluetooth."

#: src/cli/main.cpp
msgid ""
"Ask the iPhone to authenticate directly instead of connecting first. Tether "
"falls back to this on its own; use it to skip straight there."
msgstr ""
"Pedir ao iPhone que se autentique diretamente em vez de conectar primeiro. O "
"Tether recorre a isso sozinho; use para ir direto a essa opção."

#: src/cli/main.cpp
msgid "Remove a Bluetooth bond."
msgstr "Remover um vínculo Bluetooth."

#: src/cli/main.cpp
msgid ""
"Re-advertise for ANCS so the iPhone shows its permission toggles again, "
"without removing the bond."
msgstr ""
"Anunciar novamente para o ANCS para que o iPhone mostre suas permissões de "
"novo, sem remover o vínculo."

#: src/cli/main.cpp
msgid "Connect to the iPhone over Bluetooth, or stop."
msgstr "Conectar ao iPhone por Bluetooth, ou parar."

#: src/cli/main.cpp
msgid "Turn notification mirroring on or off."
msgstr "Ativar ou desativar o espelhamento de notificações."

#: src/cli/main.cpp
msgid "Mirror notification titles and bodies, not just the app."
msgstr "Espelhar títulos e texto das notificações, não apenas o app."

#: src/cli/main.cpp
msgid ""
"How message history and contacts are kept on disk. Encrypted uses a key from "
"the desktop keyring; none deletes what is stored and keeps nothing further."
msgstr ""
"Como o histórico de mensagens e os contatos são guardados em disco. "
"encrypted usa uma chave do chaveiro da área de trabalho; none apaga o que "
"está armazenado e não guarda mais nada."

#: src/cli/main.cpp
msgid "Choose which Bluetooth controller to use."
msgstr "Escolhe qual adaptador Bluetooth usar."

#: src/cli/main.cpp
msgid "List mirrored iPhone notifications."
msgstr "Listar as notificações espelhadas do iPhone."

#: src/cli/main.cpp
msgid "List calls on the iPhone."
msgstr "Listar as chamadas do iPhone."

#: src/cli/main.cpp
msgid "Place a call from the iPhone."
msgstr "Fazer uma chamada pelo iPhone."

#: src/cli/main.cpp
msgid "Answer the ringing call."
msgstr "Atender a chamada recebida."

#: src/cli/main.cpp
msgid "Hang up every call."
msgstr "Encerrar todas as chamadas."

#: src/cli/main.cpp
msgid ""
"Turn call control on or off. Calls run over Bluetooth Hands-Free; the audio "
"stays on the iPhone."
msgstr ""
"Ativar ou desativar o controle de chamadas. As chamadas usam o viva-voz "
"Bluetooth; o áudio fica no iPhone."

#: src/cli/main.cpp
msgid "Print a redacted Bluetooth report for a bug report."
msgstr "Imprimir um relatório Bluetooth sanitizado para um relato de erro."

#: src/cli/main.cpp
msgid ""
"Install the browser and mail extension's native messaging manifests for this "
"user. Needed only for portable builds; the distro packages install them "
"system-wide."
msgstr ""
"Instala os manifestos de mensagens nativas da extensão de navegador e de e-"
"mail para este usuário. Necessário apenas em builds portáteis; os pacotes da "
"distribuição os instalam para todo o sistema."

#: src/cli/main.cpp
msgid ""
"Write the tether-btclass@.service unit, which sets the Bluetooth adapter "
"class iOS requires. Needs root, and never enables it. Needed only for "
"portable builds; the distro packages install it."
msgstr ""
"Grava a unidade tether-btclass@.service, que define a classe do adaptador "
"Bluetooth exigida pelo iOS. Precisa de root e nunca a habilita. Necessário "
"apenas para builds portáteis; os pacotes da distribuição a instalam."

#: src/cli/main.cpp
msgid "Accept a pending pairing request locally."
msgstr "Aceitar localmente uma solicitação de pareamento pendente."

#: src/cli/main.cpp
msgid "Remove a Wi-Fi pairing and drop its session."
msgstr "Remover um pareamento Wi-Fi e encerrar sua sessão."

#: src/cli/main.cpp
msgid "Send a pair_request over TCP to the daemon."
msgstr "Enviar um pair_request ao daemon por TCP."

#: src/cli/main.cpp
msgid "tether - Wayland companion CLI"
msgstr "tether - CLI complementar para Wayland"

#: src/cli/main.cpp
msgid "Options:"
msgstr "Opções:"

