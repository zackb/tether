#, c++-format
msgid "Writing {} needs root. Run this with sudo.\n"
msgstr "Zápis {} vyžaduje root. Spusťte to přes sudo.\n"

#: src/cli/main.cpp
#, c++-format
msgid "Could not write {}.\n"
msgstr "Nepodařilo se zapsat {}.\n"

#: src/cli/main.cpp
#, c-format
msgid ""
"\n"
"It is not enabled. Run 'systemctl daemon-reload', then 'systemctl enable --"
"now tether-btclass@hci0' to apply it.\n"
msgstr ""
"\n"
"Není povolena. Spusťte 'systemctl daemon-reload' a poté 'systemctl enable --"
"now tether-btclass@hci0', aby se použila.\n"

