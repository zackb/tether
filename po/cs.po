#: src/cli/main.cpp
msgid "yes"
msgstr "ano"

#: src/cli/main.cpp
msgid "no"
msgstr "ne"

#: src/cli/main.cpp
msgid "Show this help message."
msgstr "Zobrazit tuto nápovědu."

#: src/cli/main.cpp
msgid "Print the tether version."
msgstr "Vypsat verzi tether."

#: src/cli/main.cpp
msgid "Retrieve the current Wayland clipboard text."
msgstr "Získat aktuální text ze schránky Waylandu."

#: src/cli/main.cpp
msgid "Take string input and copy it to the local Wayland clipboard."
msgstr "Načíst text ze vstupu a zkopírovat jej do místní schránky Waylandu."

#: src/cli/main.cpp
msgid "Send a file through tether."
msgstr "Odeslat soubor přes tether."

#: src/cli/main.cpp
msgid "Start the browser Native Messaging Host proxy loop."
msgstr "Spustit proxy smyčku Native Messaging Host prohlížeče."

#: src/cli/main.cpp
msgid "Scan the local network for tetherd instances via mDNS."
msgstr "Prohledat místní síť na instance tetherd přes mDNS."

#: src/cli/main.cpp
msgid "Connect over TCP to daemon ip instead of UNIX Socket."
msgstr "Připojit se přes TCP na ip démona místo unixového socketu."

#: src/cli/main.cpp
msgid "Connect over TCP port (default 5134)."
msgstr "TCP port pro připojení (výchozí 5134)."

#: src/cli/main.cpp
msgid "Discovery scan duration in milliseconds (default 3000)."
msgstr "Délka vyhledávání v milisekundách (výchozí 3000)."

#: src/cli/main.cpp
msgid "List all paired connection devices."
msgstr "Vypsat všechna spárovaná zařízení."

#: src/cli/main.cpp
msgid "Show the one-time system setup Bluetooth still needs."
msgstr ""
"Zobrazit jednorázové nastavení systému, které Bluetooth ještě potřebuje."

#: src/cli/main.cpp
msgid "Show Bluetooth adapter capability and delivery mode."
msgstr "Zobrazit schopnosti Bluetooth adaptéru a režim doručování."

#: src/cli/main.cpp
msgid "List Bluetooth devices known to BlueZ."
msgstr "Vypsat Bluetooth zařízení známá BlueZ."

#: src/cli/main.cpp
msgid "Show Bluetooth link and profile connection state."
msgstr "Zobrazit stav Bluetooth spojení a profilů."

#: src/cli/main.cpp
msgid "List iPhone message conversations."
msgstr "Vypsat konverzace zpráv z iPhonu."

#: src/cli/main.cpp
msgid "Show messages in one conversation."
msgstr "Zobrazit zprávy jedné konverzace."

#: src/cli/main.cpp
msgid "Reply in one conversation."
msgstr "Odpovědět v jedné konverzaci."

#: src/cli/main.cpp
msgid "List iPhone contacts, or search them by name or number."
msgstr "Vypsat kontakty z iPhonu nebo je vyhledat podle jména či čísla."

#: src/cli/main.cpp
msgid "Pair with an iPhone over Bluetooth."
msgstr "Spárovat iPhone přes Bluetooth."

#: src/cli/main.cpp
msgid ""
"Ask the iPhone to authenticate directly instead of connecting first. Tether "
"falls back to this on its own; use it to skip straight there."
msgstr ""
"Požádat iPhone o přímé ověření místo prvotního připojení. Tether se k tomu "
"uchýlí sám; použijte pro přímý přechod."

#: src/cli/main.cpp
msgid "Remove a Bluetooth bond."
msgstr "Odstranit Bluetooth vazbu."

#: src/cli/main.cpp
msgid ""
"Re-advertise for ANCS so the iPhone shows its permission toggles again, "
"without removing the bond."
msgstr ""
"Znovu se ohlásit pro ANCS, aby iPhone opět zobrazil svá oprávnění, bez "
"odstranění vazby."

#: src/cli/main.cpp
msgid "Connect to the iPhone over Bluetooth, or stop."
msgstr "Připojit se k iPhonu přes Bluetooth, nebo přestat."

#: src/cli/main.cpp
msgid "Turn notification mirroring on or off."
msgstr "Zapnout nebo vypnout zrcadlení oznámení."

#: src/cli/main.cpp
msgid "Mirror notification titles and bodies, not just the app."
msgstr "Zrcadlit názvy a text oznámení, nejen aplikaci."

#: src/cli/main.cpp
msgid ""
"How message history and contacts are kept on disk. Encrypted uses a key from "
"the desktop keyring; none deletes what is stored and keeps nothing further."
msgstr ""
"Jak se na disku uchovává historie zpráv a kontakty. encrypted použije klíč z "
"klíčenky prostředí; none smaže uložená data a dál nic neuchovává."

#: src/cli/main.cpp
msgid "Choose which Bluetooth controller to use."
msgstr "Vybere, který adaptér Bluetooth se použije."

#: src/cli/main.cpp
msgid "List mirrored iPhone notifications."
msgstr "Vypsat zrcadlená oznámení z iPhonu."

#: src/cli/main.cpp
msgid "List calls on the iPhone."
msgstr "Vypsat hovory na iPhonu."

#: src/cli/main.cpp
msgid "Place a call from the iPhone."
msgstr "Zavolat z iPhonu."

#: src/cli/main.cpp
msgid "Answer the ringing call."
msgstr "Přijmout příchozí hovor."

#: src/cli/main.cpp
msgid "Hang up every call."
msgstr "Ukončit všechny hovory."

#: src/cli/main.cpp
msgid ""
"Turn call control on or off. Calls run over Bluetooth Hands-Free; the audio "
"stays on the iPhone."
msgstr ""
"Zapnout nebo vypnout ovládání hovorů. Hovory jdou přes Bluetooth hands-free; "
"zvuk zůstává v iPhonu."

#: src/cli/main.cpp
msgid "Print a redacted Bluetooth report for a bug report."
msgstr "Vypsat očištěnou zprávu o Bluetooth pro hlášení chyby."

#: src/cli/main.cpp
msgid ""
"Install the browser and mail extension's native messaging manifests for this "
"user. Needed only for portable builds; the distro packages install them "
"system-wide."
msgstr ""
"Nainstaluje manifesty nativního zasílání zpráv rozšíření pro prohlížeč a "
"poštu pro tohoto uživatele. Potřeba jen u přenosných sestavení; distribuční "
"balíčky je instalují pro celý systém."

#: src/cli/main.cpp
msgid ""
"Write the tether-btclass@.service unit, which sets the Bluetooth adapter "
"class iOS requires. Needs root, and never enables it. Needed only for "
"portable builds; the distro packages install it."
msgstr ""
"Zapíše jednotku tether-btclass@.service, která nastavuje třídu adaptéru "
"Bluetooth vyžadovanou systémem iOS. Vyžaduje root a nikdy ji nepovolí. "
"Potřebné pouze pro přenosná sestavení; balíčky distribuce ji instalují samy."

#: src/cli/main.cpp
msgid "Accept a pending pairing request locally."
msgstr "Přijmout čekající žádost o spárování místně."

#: src/cli/main.cpp
msgid "Remove a Wi-Fi pairing and drop its session."
msgstr "Odstranit spárování přes Wi-Fi a ukončit jeho relaci."

#: src/cli/main.cpp
msgid "Send a pair_request over TCP to the daemon."
msgstr "Odeslat pair_request démonovi přes TCP."

#: src/cli/main.cpp
msgid "tether - Wayland companion CLI"
msgstr "tether - doprovodný nástroj příkazové řádky pro Wayland"

#: src/cli/main.cpp
msgid "Options:"
msgstr "Volby:"

#: src/cli/main.cpp
msgid "Examples:"
msgstr "Příklady:"

