msgstr "Bir numara gerekli, örn. --bt-call +15551234567\n"

#: src/cli/main.cpp
msgid "Dialing."
msgstr "Aranıyor."

#: src/cli/main.cpp
msgid "Answering."
msgstr "Yanıtlanıyor."

#: src/cli/main.cpp
msgid "Hanging up."
msgstr "Kapatılıyor."

#: src/cli/main.cpp
