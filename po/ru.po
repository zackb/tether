#: src/cli/main.cpp
msgid "yes"
msgstr "да"

#: src/cli/main.cpp
msgid "no"
msgstr "нет"

#: src/cli/main.cpp
msgid "Show this help message."
msgstr "Показать эту справку."

#: src/cli/main.cpp
msgid "Print the tether version."
msgstr "Показать версию tether."

#: src/cli/main.cpp
msgid "Retrieve the current Wayland clipboard text."
msgstr "Получить текущий текст из буфера обмена Wayland."

#: src/cli/main.cpp
msgid "Take string input and copy it to the local Wayland clipboard."
msgstr ""
"Прочитать текст со входа и скопировать его в локальный буфер обмена Wayland."

#: src/cli/main.cpp
msgid "Send a file through tether."
msgstr "Отправить файл через tether."

#: src/cli/main.cpp
msgid "Start the browser Native Messaging Host proxy loop."
msgstr "Запустить прокси-цикл Native Messaging Host браузера."

#: src/cli/main.cpp
msgid "Scan the local network for tetherd instances via mDNS."
msgstr "Найти экземпляры tetherd в локальной сети через mDNS."

#: src/cli/main.cpp
msgid "Connect over TCP to daemon ip instead of UNIX Socket."
msgstr "Подключиться по TCP к ip демона вместо сокета UNIX."

#: src/cli/main.cpp
msgid "Connect over TCP port (default 5134)."
msgstr "Порт TCP для подключения (по умолчанию 5134)."

#: src/cli/main.cpp
msgid "Discovery scan duration in milliseconds (default 3000)."
msgstr "Длительность поиска в миллисекундах (по умолчанию 3000)."

#: src/cli/main.cpp
msgid "List all paired connection devices."
msgstr "Показать все сопряжённые устройства."

#: src/cli/main.cpp
msgid "Show the one-time system setup Bluetooth still needs."
msgstr "Показать разовую настройку системы, которая ещё нужна Bluetooth."

#: src/cli/main.cpp
msgid "Show Bluetooth adapter capability and delivery mode."
msgstr "Показать возможности адаптера Bluetooth и режим доставки."

#: src/cli/main.cpp
msgid "List Bluetooth devices known to BlueZ."
msgstr "Показать устройства Bluetooth, известные BlueZ."

#: src/cli/main.cpp
msgid "Show Bluetooth link and profile connection state."
msgstr "Показать состояние соединения Bluetooth и профилей."

#: src/cli/main.cpp
msgid "List iPhone message conversations."
msgstr "Показать переписки с сообщениями на iPhone."

#: src/cli/main.cpp
msgid "Show messages in one conversation."
msgstr "Показать сообщения одной переписки."

#: src/cli/main.cpp
msgid "Reply in one conversation."
msgstr "Ответить в одной переписке."

#: src/cli/main.cpp
msgid "List iPhone contacts, or search them by name or number."
msgstr "Показать контакты iPhone или найти их по имени либо номеру."

#: src/cli/main.cpp
msgid "Pair with an iPhone over Bluetooth."
msgstr "Создать пару с iPhone по Bluetooth."

#: src/cli/main.cpp
msgid ""
"Ask the iPhone to authenticate directly instead of connecting first. Tether "
"falls back to this on its own; use it to skip straight there."
msgstr ""
"Запросить у iPhone прямую аутентификацию вместо предварительного "
"подключения. Tether сам переходит к этому; используйте, чтобы перейти сразу."

#: src/cli/main.cpp
msgid "Remove a Bluetooth bond."
msgstr "Удалить связь Bluetooth."

#: src/cli/main.cpp
msgid ""
"Re-advertise for ANCS so the iPhone shows its permission toggles again, "
"without removing the bond."
msgstr ""
"Заново объявить о себе для ANCS, чтобы iPhone снова показал свои разрешения, "
"не удаляя связь."

#: src/cli/main.cpp
msgid "Connect to the iPhone over Bluetooth, or stop."
msgstr "Подключиться к iPhone по Bluetooth или прекратить."

#: src/cli/main.cpp
msgid "Turn notification mirroring on or off."
msgstr "Включить или выключить дублирование уведомлений."

#: src/cli/main.cpp
msgid "Mirror notification titles and bodies, not just the app."
msgstr "Дублировать заголовки и текст уведомлений, а не только приложение."

#: src/cli/main.cpp
msgid ""
"How message history and contacts are kept on disk. Encrypted uses a key from "
"the desktop keyring; none deletes what is stored and keeps nothing further."
msgstr ""
"Как история сообщений и контакты хранятся на диске. encrypted использует "
"ключ из связки ключей рабочего стола; none удаляет сохранённое и больше "
"ничего не хранит."

#: src/cli/main.cpp
msgid "Choose which Bluetooth controller to use."
msgstr "Выбор используемого адаптера Bluetooth."

#: src/cli/main.cpp
msgid "List mirrored iPhone notifications."
msgstr "Показать продублированные уведомления iPhone."

#: src/cli/main.cpp
msgid "List calls on the iPhone."
msgstr "Показать вызовы на iPhone."

#: src/cli/main.cpp
msgid "Place a call from the iPhone."
msgstr "Совершить вызов с iPhone."

#: src/cli/main.cpp
msgid "Answer the ringing call."
msgstr "Ответить на входящий вызов."

#: src/cli/main.cpp
msgid "Hang up every call."
msgstr "Завершить все вызовы."

#: src/cli/main.cpp
msgid ""
"Turn call control on or off. Calls run over Bluetooth Hands-Free; the audio "
"stays on the iPhone."
msgstr ""
"Включить или выключить управление вызовами. Вызовы идут через Bluetooth "
"Hands-Free; звук остаётся на iPhone."

#: src/cli/main.cpp
msgid "Print a redacted Bluetooth report for a bug report."
msgstr "Вывести очищенный отчёт Bluetooth для сообщения об ошибке."

#: src/cli/main.cpp
msgid ""
"Install the browser and mail extension's native messaging manifests for this "
"user. Needed only for portable builds; the distro packages install them "
"system-wide."
msgstr ""
"Устанавливает манифесты нативного обмена сообщениями для расширения браузера "
"и почты для этого пользователя. Нужно только для переносимых сборок; пакеты "
"дистрибутивов ставят их для всей системы."

#: src/cli/main.cpp
msgid ""
"Write the tether-btclass@.service unit, which sets the Bluetooth adapter "
"class iOS requires. Needs root, and never enables it. Needed only for "
"portable builds; the distro packages install it."
msgstr ""
"Записывает юнит tether-btclass@.service, задающий класс Bluetooth-адаптера, "
"который требует iOS. Требует root и никогда его не включает. Нужно только "
"для переносимых сборок; пакеты дистрибутива устанавливают его сами."

#: src/cli/main.cpp
msgid "Accept a pending pairing request locally."
msgstr "Принять ожидающий запрос на сопряжение локально."

#: src/cli/main.cpp
msgid "Remove a Wi-Fi pairing and drop its session."
msgstr "Удалить сопряжение по Wi-Fi и закрыть его сеанс."

#: src/cli/main.cpp
msgid "Send a pair_request over TCP to the daemon."
msgstr "Отправить pair_request демону по TCP."

#: src/cli/main.cpp
msgid "tether - Wayland companion CLI"
msgstr "tether — вспомогательная утилита командной строки для Wayland"

#: src/cli/main.cpp
msgid "Options:"
msgstr "Параметры:"

#: src/cli/main.cpp
msgid "Examples:"
msgstr "Примеры:"

