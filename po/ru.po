#: src/cli/main.cpp
msgid "Dialing."
msgstr "Идёт набор."

#: src/cli/main.cpp
msgid "Answering."
msgstr "Ответ на вызов."

#: src/cli/main.cpp
msgid "Hanging up."
msgstr "Завершение вызова."

