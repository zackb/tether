#: src/cli/main.cpp
msgid "yes"
msgstr "tak"

#: src/cli/main.cpp
msgid "no"
msgstr "nie"

#: src/cli/main.cpp
msgid "Show this help message."
msgstr "Wyświetl tę pomoc."

#: src/cli/main.cpp
msgid "Print the tether version."
msgstr "Wyświetl wersję tether."

#: src/cli/main.cpp
msgid "Retrieve the current Wayland clipboard text."
msgstr "Pobierz bieżący tekst ze schowka Waylanda."

#: src/cli/main.cpp
msgid "Take string input and copy it to the local Wayland clipboard."
msgstr "Wczytaj tekst z wejścia i skopiuj go do lokalnego schowka Waylanda."

#: src/cli/main.cpp
msgid "Send a file through tether."
msgstr "Wyślij plik przez tether."

#: src/cli/main.cpp
msgid "Start the browser Native Messaging Host proxy loop."
msgstr "Uruchom pętlę proxy Native Messaging Host przeglądarki."

#: src/cli/main.cpp
msgid "Scan the local network for tetherd instances via mDNS."
msgstr "Przeszukaj sieć lokalną w poszukiwaniu instancji tetherd przez mDNS."

#: src/cli/main.cpp
msgid "Connect over TCP to daemon ip instead of UNIX Socket."
msgstr "Połącz się przez TCP z ip demona zamiast z gniazdem UNIX."

#: src/cli/main.cpp
msgid "Connect over TCP port (default 5134)."
msgstr "Port TCP połączenia (domyślnie 5134)."

#: src/cli/main.cpp
msgid "Discovery scan duration in milliseconds (default 3000)."
msgstr "Czas trwania wyszukiwania w milisekundach (domyślnie 3000)."

#: src/cli/main.cpp
msgid "List all paired connection devices."
msgstr "Wypisz wszystkie sparowane urządzenia."

#: src/cli/main.cpp
msgid "Show the one-time system setup Bluetooth still needs."
msgstr ""
"Pokaż jednorazową konfigurację systemu, której Bluetooth jeszcze wymaga."

#: src/cli/main.cpp
msgid "Show Bluetooth adapter capability and delivery mode."
msgstr "Pokaż możliwości adaptera Bluetooth i tryb dostarczania."

#: src/cli/main.cpp
msgid "List Bluetooth devices known to BlueZ."
msgstr "Wypisz urządzenia Bluetooth znane BlueZ."

#: src/cli/main.cpp
msgid "Show Bluetooth link and profile connection state."
msgstr "Pokaż stan połączenia Bluetooth i profili."

#: src/cli/main.cpp
msgid "List iPhone message conversations."
msgstr "Wypisz rozmowy z wiadomościami z iPhone'a."

#: src/cli/main.cpp
msgid "Show messages in one conversation."
msgstr "Pokaż wiadomości jednej rozmowy."

#: src/cli/main.cpp
msgid "Reply in one conversation."
msgstr "Odpowiedz w jednej rozmowie."

#: src/cli/main.cpp
msgid "List iPhone contacts, or search them by name or number."
msgstr "Wypisz kontakty z iPhone'a lub wyszukaj je według nazwy albo numeru."

#: src/cli/main.cpp
msgid "Pair with an iPhone over Bluetooth."
msgstr "Sparuj iPhone'a przez Bluetooth."

#: src/cli/main.cpp
msgid ""
"Ask the iPhone to authenticate directly instead of connecting first. Tether "
"falls back to this on its own; use it to skip straight there."
msgstr ""
"Poproś iPhone'a o bezpośrednie uwierzytelnienie zamiast najpierw łączenia. "
"Tether sam się do tego ucieka; użyj, aby przejść od razu."

#: src/cli/main.cpp
msgid "Remove a Bluetooth bond."
msgstr "Usuń powiązanie Bluetooth."

#: src/cli/main.cpp
msgid ""
"Re-advertise for ANCS so the iPhone shows its permission toggles again, "
"without removing the bond."
msgstr ""
"Ogłoś się ponownie dla ANCS, aby iPhone znów pokazał swoje uprawnienia, bez "
"usuwania powiązania."

#: src/cli/main.cpp
msgid "Connect to the iPhone over Bluetooth, or stop."
msgstr "Połącz się z iPhone'em przez Bluetooth albo przerwij."

#: src/cli/main.cpp
msgid "Turn notification mirroring on or off."
msgstr "Włącz lub wyłącz kopiowanie powiadomień."

#: src/cli/main.cpp
msgid "Mirror notification titles and bodies, not just the app."
msgstr "Kopiuj tytuły i treść powiadomień, nie tylko aplikację."

#: src/cli/main.cpp
msgid ""
"How message history and contacts are kept on disk. Encrypted uses a key from "
"the desktop keyring; none deletes what is stored and keeps nothing further."
msgstr ""
"Jak historia wiadomości i kontakty są przechowywane na dysku. encrypted "
"używa klucza z pęku kluczy środowiska; none usuwa zapisane dane i niczego "
"dalej nie przechowuje."

#: src/cli/main.cpp
msgid "Choose which Bluetooth controller to use."
msgstr "Wybiera używany adapter Bluetooth."

#: src/cli/main.cpp
msgid "List mirrored iPhone notifications."
msgstr "Wypisz skopiowane powiadomienia z iPhone'a."

#: src/cli/main.cpp
msgid "List calls on the iPhone."
msgstr "Wyświetl połączenia na iPhonie."

#: src/cli/main.cpp
msgid "Place a call from the iPhone."
msgstr "Nawiąż połączenie z iPhone’a."

#: src/cli/main.cpp
msgid "Answer the ringing call."
msgstr "Odbierz przychodzące połączenie."

#: src/cli/main.cpp
msgid "Hang up every call."
msgstr "Zakończ wszystkie połączenia."

#: src/cli/main.cpp
msgid ""
"Turn call control on or off. Calls run over Bluetooth Hands-Free; the audio "
"stays on the iPhone."
msgstr ""
"Włącz lub wyłącz sterowanie połączeniami. Połączenia idą przez zestaw "
"głośnomówiący Bluetooth; dźwięk zostaje na iPhonie."

#: src/cli/main.cpp
msgid "Print a redacted Bluetooth report for a bug report."
msgstr "Wypisz oczyszczony raport Bluetooth do zgłoszenia błędu."

#: src/cli/main.cpp
msgid ""
"Install the browser and mail extension's native messaging manifests for this "
"user. Needed only for portable builds; the distro packages install them "
"system-wide."
msgstr ""
"Instaluje manifesty natywnej komunikacji rozszerzenia przeglądarki i poczty "
"dla tego użytkownika. Potrzebne tylko w wersjach przenośnych; pakiety "
"dystrybucji instalują je systemowo."

#: src/cli/main.cpp
msgid ""
"Write the tether-btclass@.service unit, which sets the Bluetooth adapter "
"class iOS requires. Needs root, and never enables it. Needed only for "
"portable builds; the distro packages install it."
msgstr ""
"Zapisuje jednostkę tether-btclass@.service, która ustawia klasę adaptera "
"Bluetooth wymaganą przez iOS. Wymaga roota i nigdy jej nie włącza. Potrzebne "
"tylko dla wersji przenośnych; pakiety dystrybucji instalują ją same."

#: src/cli/main.cpp
msgid "Accept a pending pairing request locally."
msgstr "Zaakceptuj lokalnie oczekujące żądanie parowania."

#: src/cli/main.cpp
msgid "Remove a Wi-Fi pairing and drop its session."
msgstr "Usuń parowanie Wi-Fi i zakończ jego sesję."

#: src/cli/main.cpp
msgid "Send a pair_request over TCP to the daemon."
msgstr "Wyślij pair_request do demona przez TCP."

#: src/cli/main.cpp
msgid "tether - Wayland companion CLI"
msgstr "tether - towarzyszące narzędzie wiersza poleceń dla Waylanda"

#: src/cli/main.cpp
msgid "Options:"
msgstr "Opcje:"

#: src/cli/main.cpp
msgid "Examples:"
msgstr "Przykłady:"

#: src/cli/main.cpp
#, c-format
msgid "Installed %s\n"
msgstr "Zainstalowano %s\n"

#: src/cli/main.cpp
#, c-format
msgid ""
"No browser or mail client profile was found for this user, so nothing was "
"installed. Start Firefox, Thunderbird, or Chromium once and run this again.\n"
msgstr ""
"Nie znaleziono profilu przeglądarki ani klienta poczty dla tego użytkownika, "
"więc nic nie zainstalowano. Uruchom raz przeglądarkę Firefox, program "
"Thunderbird lub Chromium i wykonaj to ponownie.\n"

#: src/cli/main.cpp
#, c-format
msgid ""
"\n"
"Restart the browser or mail client to pick this up.\n"
msgstr ""
"\n"
"Uruchom ponownie przeglądarkę lub klienta poczty, aby to zadziałało.\n"

#: src/cli/main.cpp
#, c++-format
msgid "Writing {} needs root. Run this with sudo.\n"
msgstr "Zapis {} wymaga roota. Uruchom to przez sudo.\n"

#: src/cli/main.cpp
#, c++-format
msgid "Could not write {}.\n"
msgstr "Nie udało się zapisać {}.\n"

#: src/cli/main.cpp
#, c-format
msgid ""
"\n"
"It is not enabled. Run 'systemctl daemon-reload', then 'systemctl enable --"
"now tether-btclass@hci0' to apply it.\n"
msgstr ""
"\n"
"Nie jest włączona. Uruchom 'systemctl daemon-reload', a następnie 'systemctl "
"enable --now tether-btclass@hci0', aby ją zastosować.\n"

#: src/cli/main.cpp
msgid "Could not read Bluetooth status from the daemon.\n"
msgstr "Nie udało się odczytać stanu Bluetooth od demona.\n"

#: src/cli/main.cpp
#, c-format
msgid "Bluetooth: unavailable (is bluetoothd running?)\n"
msgstr "Bluetooth: niedostępny (czy bluetoothd działa?)\n"

#: src/cli/main.cpp
#, c-format
msgid "Bluetooth setup is complete. Nothing to do.\n"
msgstr "Konfiguracja Bluetooth jest zakończona. Nie ma nic do zrobienia.\n"

#: src/cli/main.cpp
#, c-format
msgid ""
"\n"
"%zu step left before the iPhone Bluetooth features work:\n"
msgid_plural ""
"\n"
"%zu steps left before the iPhone Bluetooth features work:\n"
msgstr[0] ""
"\n"
"Pozostał %zu krok, zanim funkcje Bluetooth iPhone'a zadziałają:\n"
msgstr[1] ""
"\n"
"Pozostały %zu kroki, zanim funkcje Bluetooth iPhone'a zadziałają:\n"
msgstr[2] ""
"\n"
"Pozostało %zu kroków, zanim funkcje Bluetooth iPhone'a zadziałają:\n"

#: src/cli/main.cpp
#, c-format
msgid ""
"\n"
"Re-run 'tether --bt-setup' afterwards to confirm.\n"
msgstr ""
"\n"
"Potem uruchom ponownie 'tether --bt-setup', aby to potwierdzić.\n"

