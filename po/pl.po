msgstr ""
"Jawne połączenie frameworku zostało lokalnie odrzucone! Czy wskazano jawnie "
"nieprawidłowy TLS, czy demon jest uszkodzony?\n"

#: src/cli/main.cpp
msgid "--forget expects a fingerprint.\n"
msgstr "--forget oczekuje odcisku.\n"

#: src/cli/main.cpp
msgid "No paired device with that fingerprint.\n"
msgstr "Brak sparowanego urządzenia o tym odcisku.\n"

#: src/cli/main.cpp
#, c++-format
msgid "Transfer Failed: {}"
msgstr "Przesyłanie nie powiodło się: {}"

#: src/cli/main.cpp
msgid "A number is required, e.g. --bt-call +15551234567\n"
msgstr "Wymagany jest numer, np. --bt-call +15551234567\n"

#: src/cli/main.cpp
msgid "Dialing."
msgstr "Wybieranie numeru."

#: src/cli/main.cpp
msgid "Answering."
msgstr "Odbieranie."

#: src/cli/main.cpp
msgid "Hanging up."
msgstr "Rozłączanie."

#: src/cli/main.cpp
msgid "Expected on or off, e.g. --bt-calls-enable on\n"
msgstr "Oczekiwano on lub off, np. --bt-calls-enable on\n"

#: src/cli/main.cpp
msgid "Call control enabled."
msgstr "Sterowanie połączeniami włączone."

#: src/cli/main.cpp
msgid "Call control disabled."
msgstr "Sterowanie połączeniami wyłączone."

#: src/cli/main.cpp
msgid "A thread key is required, e.g. --bt-messages tel:+15551234567\n"
msgstr "Wymagany jest klucz rozmowy, np. --bt-messages tel:+15551234567\n"

#: src/cli/main.cpp
msgid ""
"A conversation and a message are required, e.g. --bt-send tel:+15551234567 "
"\"hi\"\n"
msgstr ""
"Wymagana jest rozmowa i wiadomość, np. --bt-send tel:+15551234567 \"cześć\"\n"

#: src/cli/main.cpp
msgid "A Bluetooth address is required, e.g. --bt-pair AA:BB:CC:DD:EE:FF\n"
msgstr "Wymagany jest adres Bluetooth, np. --bt-pair AA:BB:CC:DD:EE:FF\n"

#: src/cli/main.cpp
msgid "Expected on or off, e.g. --bt-enable off\n"
msgstr "Oczekiwano on lub off, np. --bt-enable off\n"

#: src/cli/main.cpp
#, c-format
msgid "Bluetooth enabled.\n"
msgstr "Bluetooth włączony.\n"

#: src/cli/main.cpp
#, c-format
msgid ""
"Bluetooth disabled. Tether will not reconnect the iPhone. A link that is\n"
"already up stays up until you disconnect it or the phone goes out of range.\n"
msgstr ""
"Bluetooth wyłączony. Tether nie połączy iPhone'a ponownie. Połączenie, "
"które\n"
"już działa, pozostanie aktywne, dopóki go nie rozłączysz lub telefon nie "
"wyjdzie poza zasięg.\n"

#: src/cli/main.cpp
#, c++-format
msgid "Expected on or off, e.g. {} on\n"
msgstr "Oczekiwano on lub off, np. {} on\n"

#: src/cli/main.cpp
msgid "Notification contents enabled."
