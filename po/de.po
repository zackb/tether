#~ "  --bt-threads             Nachrichtenunterhaltungen des iPhones "
#~ "auflisten.\n"
#~ "  --bt-messages <thread>   Nachrichten einer Unterhaltung anzeigen.\n"
#~ "  --bt-send <thread> <text>  In einer Unterhaltung antworten.\n"
#~ "  --bt-pair <addr>         Ein iPhone per Bluetooth koppeln.\n"
#~ "  --bt-unpair <addr>       Eine Bluetooth-Bindung entfernen.\n"
#~ "  --bt-solicit             Erneut für ANCS werben, damit das iPhone seine "
#~ "Berechtigungen wieder\n"
#~ "                           anzeigt, ohne die Bindung zu entfernen.\n"
#~ "  --bt-enable <on|off>     Per Bluetooth mit dem iPhone verbinden oder "
#~ "damit aufhören.\n"
#~ "  --bt-ancs <on|off>       Die Spiegelung von Mitteilungen ein- oder "
#~ "ausschalten.\n"
#~ "  --bt-ancs-content <on|off>  Titel und Text der Mitteilungen spiegeln, "
#~ "nicht nur die App.\n"
#~ "  --bt-notifications       Gespiegelte iPhone-Mitteilungen auflisten.\n"
#~ "  --bt-diagnostics         Einen bereinigten Bluetooth-Bericht für "
#~ "Fehlermeldungen ausgeben.\n"
#~ "  --accept <fingerprint>   Eine ausstehende Kopplungsanfrage lokal "
#~ "annehmen.\n"
#~ "  --pair                   Einen pair_request per TCP an den Daemon "
#~ "senden.\n"
#~ "\n"
#~ "Beispiele:\n"
#~ "  tether -g\n"
#~ "  tether -g --host 127.0.0.1\n"
#~ "  echo \"pipe\" | tether -s\n"
#~ "  tether --discover\n"
#~ "  tether --discover --timeout 5000\n"
#~ "  tether -f ./report.pdf\n"
#~ "  tether --accept 9a4f21...\n"

#, c-format
#~ msgid "Mode:       %s\n"
#~ msgstr "Modus:      %s\n"

#, c-format
#~ msgid "Bond:       %s\n"
#~ msgstr "Bindung:    %s\n"

#, c-format
#~ msgid "Tether:     %s\n"
#~ msgstr "Tether:     %s\n"

#, c-format
#~ msgid "BR/EDR:          %s\n"
#~ msgstr "BR/EDR:          %s\n"

#, c-format
#~ msgid "LE:              %s%s\n"
#~ msgstr "LE:              %s%s\n"

#, c-format
#~ msgid ""
#~ "\n"
#~ "Notifications:   %s\n"
#~ msgstr ""
#~ "\n"
#~ "Mitteilungen:    %s\n"

#~ msgid "Waiting for the Bluetooth link."
#~ msgstr "Warten auf die Bluetooth-Verbindung."
