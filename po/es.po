#: src/cli/main.cpp
msgid "yes"
msgstr "sí"

#: src/cli/main.cpp
msgid "no"
msgstr "no"

#: src/cli/main.cpp
msgid "Show this help message."
msgstr "Mostrar esta ayuda."

#: src/cli/main.cpp
msgid "Print the tether version."
msgstr "Mostrar la versión de tether."

#: src/cli/main.cpp
msgid "Retrieve the current Wayland clipboard text."
msgstr "Obtener el texto actual del portapapeles de Wayland."

#: src/cli/main.cpp
msgid "Take string input and copy it to the local Wayland clipboard."
msgstr "Leer texto de la entrada y copiarlo al portapapeles local de Wayland."

#: src/cli/main.cpp
msgid "Send a file through tether."
msgstr "Enviar un archivo a través de tether."

#: src/cli/main.cpp
msgid "Start the browser Native Messaging Host proxy loop."
msgstr "Iniciar el bucle proxy del Native Messaging Host del navegador."

#: src/cli/main.cpp
msgid "Scan the local network for tetherd instances via mDNS."
msgstr "Buscar instancias de tetherd en la red local mediante mDNS."

#: src/cli/main.cpp
msgid "Connect over TCP to daemon ip instead of UNIX Socket."
msgstr "Conectar por TCP a la ip del daemon en vez de al socket UNIX."

#: src/cli/main.cpp
msgid "Connect over TCP port (default 5134)."
msgstr "Puerto TCP de conexión (por omisión 5134)."

#: src/cli/main.cpp
msgid "Discovery scan duration in milliseconds (default 3000)."
msgstr ""
"Duración del escaneo de descubrimiento en milisegundos (por omisión 3000)."

#: src/cli/main.cpp
msgid "List all paired connection devices."
msgstr "Listar todos los dispositivos emparejados."

#: src/cli/main.cpp
msgid "Show the one-time system setup Bluetooth still needs."
msgstr ""
"Mostrar la configuración inicial del sistema que aún necesita Bluetooth."

#: src/cli/main.cpp
msgid "Show Bluetooth adapter capability and delivery mode."
msgstr "Mostrar la capacidad del adaptador Bluetooth y el modo de entrega."

#: src/cli/main.cpp
msgid "List Bluetooth devices known to BlueZ."
msgstr "Listar los dispositivos Bluetooth conocidos por BlueZ."

#: src/cli/main.cpp
msgid "Show Bluetooth link and profile connection state."
msgstr "Mostrar el estado del enlace y de los perfiles Bluetooth."

#: src/cli/main.cpp
msgid "List iPhone message conversations."
msgstr "Listar las conversaciones de mensajes del iPhone."

#: src/cli/main.cpp
msgid "Show messages in one conversation."
msgstr "Mostrar los mensajes de una conversación."

#: src/cli/main.cpp
msgid "Reply in one conversation."
msgstr "Responder en una conversación."

#: src/cli/main.cpp
msgid "List iPhone contacts, or search them by name or number."
msgstr "Listar los contactos del iPhone, o buscarlos por nombre o número."

#: src/cli/main.cpp
msgid "Pair with an iPhone over Bluetooth."
msgstr "Emparejar con un iPhone por Bluetooth."

#: src/cli/main.cpp
msgid ""
"Ask the iPhone to authenticate directly instead of connecting first. Tether "
"falls back to this on its own; use it to skip straight there."
msgstr ""
"Pedir al iPhone que se autentique directamente en lugar de conectarse "
"primero. Tether recurre a esto por su cuenta; úsalo para ir directamente ahí."

#: src/cli/main.cpp
msgid "Remove a Bluetooth bond."
msgstr "Eliminar un vínculo Bluetooth."

#: src/cli/main.cpp
msgid ""
"Re-advertise for ANCS so the iPhone shows its permission toggles again, "
"without removing the bond."
msgstr ""
"Volver a anunciarse para ANCS para que el iPhone muestre de nuevo sus "
"permisos, sin eliminar el vínculo."

#: src/cli/main.cpp
msgid "Connect to the iPhone over Bluetooth, or stop."
msgstr "Conectar con el iPhone por Bluetooth, o detenerlo."

#: src/cli/main.cpp
msgid "Turn notification mirroring on or off."
msgstr "Activar o desactivar la duplicación de notificaciones."

#: src/cli/main.cpp
msgid "Mirror notification titles and bodies, not just the app."
msgstr "Duplicar títulos y contenido de las notificaciones, no solo la app."

#: src/cli/main.cpp
msgid ""
"How message history and contacts are kept on disk. Encrypted uses a key from "
"the desktop keyring; none deletes what is stored and keeps nothing further."
msgstr ""
"Cómo se guardan en disco el historial de mensajes y los contactos. encrypted "
"usa una clave del llavero del escritorio; none elimina lo almacenado y no "
"conserva nada más."

#: src/cli/main.cpp
msgid "Choose which Bluetooth controller to use."
msgstr "Elige qué adaptador Bluetooth usar."

#: src/cli/main.cpp
msgid "List mirrored iPhone notifications."
msgstr "Listar las notificaciones duplicadas del iPhone."

#: src/cli/main.cpp
msgid "List calls on the iPhone."
msgstr "Listar las llamadas del iPhone."

#: src/cli/main.cpp
msgid "Place a call from the iPhone."
msgstr "Realizar una llamada desde el iPhone."

#: src/cli/main.cpp
msgid "Answer the ringing call."
msgstr "Responder la llamada entrante."

#: src/cli/main.cpp
msgid "Hang up every call."
msgstr "Colgar todas las llamadas."

#: src/cli/main.cpp
msgid ""
"Turn call control on or off. Calls run over Bluetooth Hands-Free; the audio "
"stays on the iPhone."
msgstr ""
"Activar o desactivar el control de llamadas. Las llamadas usan el manos "
"libres Bluetooth; el audio se queda en el iPhone."

#: src/cli/main.cpp
msgid "Print a redacted Bluetooth report for a bug report."
msgstr "Imprimir un informe Bluetooth redactado para un informe de error."

#: src/cli/main.cpp
msgid ""
"Install the browser and mail extension's native messaging manifests for this "
"user. Needed only for portable builds; the distro packages install them "
"system-wide."
msgstr ""
"Instala los manifiestos de mensajería nativa de la extensión de navegador y "
"de correo para este usuario. Solo es necesario en compilaciones portables; "
"los paquetes de la distribución los instalan para todo el sistema."

#: src/cli/main.cpp
msgid ""
"Write the tether-btclass@.service unit, which sets the Bluetooth adapter "
"class iOS requires. Needs root, and never enables it. Needed only for "
"portable builds; the distro packages install it."
msgstr ""
"Escribe la unidad tether-btclass@.service, que establece la clase de "
"adaptador Bluetooth que iOS requiere. Necesita root y nunca la activa. Solo "
"es necesario para compilaciones portables; los paquetes de la distribución "
"la instalan."

#: src/cli/main.cpp
msgid "Accept a pending pairing request locally."
msgstr "Aceptar localmente una solicitud de emparejamiento pendiente."

#: src/cli/main.cpp
msgid "Remove a Wi-Fi pairing and drop its session."
msgstr "Eliminar un emparejamiento Wi-Fi y cerrar su sesión."

#: src/cli/main.cpp
msgid "Send a pair_request over TCP to the daemon."
msgstr "Enviar un pair_request al daemon por TCP."

#: src/cli/main.cpp
msgid "tether - Wayland companion CLI"
msgstr "tether - CLI complementaria para Wayland"

