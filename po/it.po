#: src/cli/main.cpp
msgid "yes"
msgstr "sì"

#: src/cli/main.cpp
msgid "no"
msgstr "no"

#: src/cli/main.cpp
msgid "Show this help message."
msgstr "Mostra questo messaggio di aiuto."

#: src/cli/main.cpp
msgid "Print the tether version."
msgstr "Mostra la versione di tether."

#: src/cli/main.cpp
msgid "Retrieve the current Wayland clipboard text."
msgstr "Recupera il testo attuale degli appunti di Wayland."

#: src/cli/main.cpp
msgid "Take string input and copy it to the local Wayland clipboard."
msgstr ""
"Legge il testo dall'ingresso e lo copia negli appunti locali di Wayland."

#: src/cli/main.cpp
msgid "Send a file through tether."
msgstr "Invia un file tramite tether."

#: src/cli/main.cpp
msgid "Start the browser Native Messaging Host proxy loop."
msgstr "Avvia il ciclo proxy Native Messaging Host del browser."

#: src/cli/main.cpp
msgid "Scan the local network for tetherd instances via mDNS."
msgstr "Cerca istanze di tetherd sulla rete locale tramite mDNS."

#: src/cli/main.cpp
msgid "Connect over TCP to daemon ip instead of UNIX Socket."
msgstr "Connetti in TCP all'ip del daemon invece che al socket UNIX."

#: src/cli/main.cpp
msgid "Connect over TCP port (default 5134)."
msgstr "Porta TCP di connessione (predefinita 5134)."

#: src/cli/main.cpp
msgid "Discovery scan duration in milliseconds (default 3000)."
msgstr "Durata della ricerca in millisecondi (predefinita 3000)."

#: src/cli/main.cpp
msgid "List all paired connection devices."
msgstr "Elenca tutti i dispositivi accoppiati."

#: src/cli/main.cpp
msgid "Show the one-time system setup Bluetooth still needs."
msgstr ""
"Mostra la configurazione di sistema una tantum che Bluetooth richiede ancora."

#: src/cli/main.cpp
msgid "Show Bluetooth adapter capability and delivery mode."
msgstr ""
"Mostra le capacità dell'adattatore Bluetooth e la modalità di consegna."

#: src/cli/main.cpp
msgid "List Bluetooth devices known to BlueZ."
msgstr "Elenca i dispositivi Bluetooth noti a BlueZ."

#: src/cli/main.cpp
msgid "Show Bluetooth link and profile connection state."
msgstr "Mostra lo stato del collegamento Bluetooth e dei profili."

#: src/cli/main.cpp
msgid "List iPhone message conversations."
msgstr "Elenca le conversazioni di messaggi dell'iPhone."

#: src/cli/main.cpp
msgid "Show messages in one conversation."
msgstr "Mostra i messaggi di una conversazione."

#: src/cli/main.cpp
msgid "Reply in one conversation."
msgstr "Rispondi in una conversazione."

#: src/cli/main.cpp
msgid "List iPhone contacts, or search them by name or number."
msgstr "Elenca i contatti dell'iPhone, o cercali per nome o numero."

#: src/cli/main.cpp
msgid "Pair with an iPhone over Bluetooth."
msgstr "Accoppia un iPhone tramite Bluetooth."

#: src/cli/main.cpp
msgid ""
"Ask the iPhone to authenticate directly instead of connecting first. Tether "
"falls back to this on its own; use it to skip straight there."
msgstr ""
"Chiedere all'iPhone di autenticarsi direttamente invece di connettersi "
"prima. Tether vi ricorre da solo; usalo per andare direttamente lì."

#: src/cli/main.cpp
msgid "Remove a Bluetooth bond."
msgstr "Rimuove un'associazione Bluetooth."

#: src/cli/main.cpp
msgid ""
"Re-advertise for ANCS so the iPhone shows its permission toggles again, "
"without removing the bond."
msgstr ""
"Si riannuncia per ANCS in modo che l'iPhone mostri di nuovo i suoi permessi, "
"senza rimuovere l'associazione."

#: src/cli/main.cpp
msgid "Connect to the iPhone over Bluetooth, or stop."
msgstr "Connetti all'iPhone tramite Bluetooth, oppure interrompi."

#: src/cli/main.cpp
msgid "Turn notification mirroring on or off."
msgstr "Attiva o disattiva il mirroring delle notifiche."

#: src/cli/main.cpp
msgid "Mirror notification titles and bodies, not just the app."
msgstr "Rispecchia titoli e testo delle notifiche, non solo l'app."

#: src/cli/main.cpp
msgid ""
"How message history and contacts are kept on disk. Encrypted uses a key from "
"the desktop keyring; none deletes what is stored and keeps nothing further."
msgstr ""
"Come vengono conservati su disco la cronologia dei messaggi e i contatti. "
"encrypted usa una chiave del portachiavi del desktop; none elimina quanto "
"memorizzato e non conserva altro."

#: src/cli/main.cpp
msgid "Choose which Bluetooth controller to use."
msgstr "Sceglie quale adattatore Bluetooth usare."

#: src/cli/main.cpp
msgid "List mirrored iPhone notifications."
msgstr "Elenca le notifiche dell'iPhone rispecchiate."

#: src/cli/main.cpp
msgid "List calls on the iPhone."
msgstr "Elencare le chiamate sull'iPhone."

#: src/cli/main.cpp
msgid "Place a call from the iPhone."
msgstr "Effettuare una chiamata dall'iPhone."

#: src/cli/main.cpp
msgid "Answer the ringing call."
msgstr "Rispondere alla chiamata in arrivo."

#: src/cli/main.cpp
msgid "Hang up every call."
msgstr "Chiudere tutte le chiamate."

#: src/cli/main.cpp
msgid ""
"Turn call control on or off. Calls run over Bluetooth Hands-Free; the audio "
"stays on the iPhone."
msgstr ""
"Attivare o disattivare il controllo delle chiamate. Le chiamate usano il "
"vivavoce Bluetooth; l'audio resta sull'iPhone."

#: src/cli/main.cpp
msgid "Print a redacted Bluetooth report for a bug report."
msgstr "Stampa un rapporto Bluetooth epurato per una segnalazione di errore."

#: src/cli/main.cpp
msgid ""
"Install the browser and mail extension's native messaging manifests for this "
"user. Needed only for portable builds; the distro packages install them "
"system-wide."
msgstr ""
"Installa i manifest di messaggistica nativa dell'estensione per browser e "
"posta per questo utente. Serve solo alle build portabili; i pacchetti della "
"distribuzione li installano a livello di sistema."

#: src/cli/main.cpp
msgid ""
"Write the tether-btclass@.service unit, which sets the Bluetooth adapter "
"class iOS requires. Needs root, and never enables it. Needed only for "
"portable builds; the distro packages install it."
msgstr ""
"Scrive l'unità tether-btclass@.service, che imposta la classe "
"dell'adattatore Bluetooth richiesta da iOS. Richiede root e non la abilita "
"mai. Serve solo per le build portabili; i pacchetti della distribuzione la "
"installano."

#: src/cli/main.cpp
msgid "Accept a pending pairing request locally."
msgstr "Accetta localmente una richiesta di accoppiamento in sospeso."

#: src/cli/main.cpp
msgid "Remove a Wi-Fi pairing and drop its session."
msgstr "Rimuove un accoppiamento Wi-Fi e chiude la sua sessione."

#: src/cli/main.cpp
msgid "Send a pair_request over TCP to the daemon."
msgstr "Invia un pair_request al daemon tramite TCP."

#: src/cli/main.cpp
msgid "tether - Wayland companion CLI"
msgstr "tether - CLI complementare per Wayland"

