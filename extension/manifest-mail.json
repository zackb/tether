{
    "manifest_version": 2,
    "name": "Tether Mail Extension",
    "version": "1.0.8",
    "description": "Extracts OTPs from emails for Tether daemon",
    "browser_specific_settings": {
        "gecko": {
            "id": "tether@tether.com",
            "strict_min_version": "137.0"
        }
    },
    "permissions": [
        "nativeMessaging",
        "messagesRead",
        "accountsRead"
    ],
    "background": {
        "scripts": [
            "src/mail/extractor.js"
        ]
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "experiment_apis": {
        "recentMail": {
            "schema": "experiments/recentMail/schema.json",
            "parent": {
                "scopes": [
                    "addon_parent"
                ],
                "paths": [
                    [
                        "recentMail"
                    ]
                ],
                "script": "experiments/recentMail/api.js"
            }
        }
    }
}
